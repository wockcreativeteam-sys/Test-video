 "VO": [
  {
   "key": "v01",
   "t": 1.35,
   "dur": 1.81,
   "text": "The first time she held your hand..."
  },
  {
   "key": "v02",
   "t": 4.35,
   "dur": 1.429,
   "text": "she taught you how to walk."
  },
  {
   "key": "v03",
   "t": 7.75,
   "dur": 3.623,
   "text": "She walked us to school. Ran behind us. Ran ahead of us."
  },
  {
   "key": "v04",
   "t": 12.55,
   "dur": 1.974,
   "text": "And somehow, always kept going."
  },
  {
   "key": "v05",
   "t": 16.9,
   "dur": 1.75,
   "text": "Then, somewhere along the way..."
  },
  {
   "key": "v06",
   "t": 20.9,
   "dur": 1.835,
   "text": "she started walking a little slower."
  },
  {
   "key": "v07a",
   "t": 25,
   "dur": 1.665,
   "text": "Not because she wanted to stop."
  },
  {
   "key": "v07b",
   "t": 27.3,
   "dur": 1.828,
   "text": "Because every step began to hurt."
  },
  {
   "key": "v08",
   "t": 29.75,
   "dur": 2.953,
   "text": "For us, she may be a patient with osteoarthritis."
  },
  {
   "key": "v09",
   "t": 33.9,
   "dur": 1.078,
   "text": "But for someone..."
  },
  {
   "key": "v10",
   "t": 37.4,
   "dur": 2.357,
   "text": "she is the woman who never stopped showing up."
  },
  {
   "key": "v11",
   "t": 41.6,
   "dur": 3.26,
   "text": "The first time she held your hand, she taught you how to walk."
  },
  {
   "key": "v12",
   "t": 45.9,
   "dur": 2.616,
   "text": "Maybe now, it's time to notice how she walks."
  },
  {
   "key": "v13a",
   "t": 49.8,
   "dur": 2.685,
   "text": "This World O. A. Day, let's take a pledge."
  },
  {
   "key": "v13b",
   "t": 52.95,
   "dur": 3.574,
   "text": "Notice the signs. Address the pain. Keep life moving."
  }
 ],
